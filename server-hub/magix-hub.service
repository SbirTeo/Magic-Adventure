[Unit]
Description=MAGICADVENTURE Hub (Paper)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hub
# Avvia il loop start.sh dentro una screen 'hub' (console per deploy e sito: screen -S hub -X stuff ...)
ExecStart=/usr/bin/screen -dmS hub /home/ubuntu/hub/start.sh
# Stop pulito: salva il mondo e interrompe il loop di start.sh (vedi stop-service.sh)
ExecStop=/home/ubuntu/hub/stop-service.sh
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
