{
  "permissions": {
    "allow": [
      "Bash(mvn -q -DskipTests package)",
      "Bash(curl -s -o /dev/null -w \"home %{http_code}\\\\n\" https://magicadventure.it/)",
      "Bash(curl -s -o /dev/null -w \"regolamento %{http_code}\\\\n\" https://magicadventure.it/regolamento)",
      "Bash(curl -s -o /dev/null -w \"sanzioni %{http_code}\\\\n\" https://magicadventure.it/sanzioni)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/teolo/progettiCLAUDE/magicadventure/plugins-src/check_hook.py\"",
            "timeout": 120,
            "statusMessage": "Controllo config/guide dei plugin..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/teolo/progettiCLAUDE/magicadventure/plugins-src/check_hook.py\"",
            "timeout": 120,
            "statusMessage": "Controllo config/guide dei plugin..."
          }
        ]
      }
    ]
  }
}