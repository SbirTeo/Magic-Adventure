{
  "permissions": {
    "allow": [
      "Bash(mvn -q -DskipTests package)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/teolo/progettiCLAUDE/magicadventure/plugins-src/hook-controlla.py\"",
            "timeout": 120,
            "statusMessage": "Controllo config/guide dei plugin..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/teolo/progettiCLAUDE/magicadventure/plugins-src/hook-controlla.py\"",
            "timeout": 120,
            "statusMessage": "Controllo config/guide dei plugin..."
          }
        ]
      }
    ]
  }
}
