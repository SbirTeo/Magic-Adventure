<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.teolo</groupId>
    <artifactId>MagixLanguage</artifactId>
    <version>0.4.14</version>
    <packaging>jar</packaging>

    <name>MagixLanguage</name>
    <description>Rileva la lingua di chi entra dal paese di provenienza e traduce i messaggi degli altri plugin Magix nella sua lingua.</description>

    <properties>
        <!-- paper-api 26.1.2 e' compilata per Java 25 (class file 69.0): serve JDK 25 per buildare.
             Sul PC di sviluppo sta in C:\Users\teolo\.jdks\jdk-25.0.3+9 (vedi README). -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <!-- Stesso build del server (log: "Paper version 26.1.2-72-ver/26.1.2"). -->
            <version>26.1.2.build.72-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- Lo stesso jar gira anche sul proxy (velocity/MagixLanguageVelocity): dopo paper-api,
             cosi' per le classi comuni (adventure, snakeyaml...) vince la versione di Paper.
             Il suo annotation processor scrive velocity-plugin.json da @Plugin. -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>4.2.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- La lingua condivisa da tutta la rete sta nel database del sito (store/LanguageStore):
             driver dentro il jar (shaded), su Paper come su Velocity. -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.4.1</version>
        </dependency>
        <!-- Opzionale a runtime (softdepend): fornito dal plugin se presente. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <!-- Da JDK 23 javac non lancia piu' da solo gli annotation processor del
                         classpath: senza, velocity-plugin.json manca e Velocity ignora il jar. -->
                    <proc>full</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.mariadb.jdbc:mariadb-java-client</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.mariadb</pattern>
                                    <shadedPattern>com.teolo.magixlanguage.lib.mariadb</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- README nel jar: il plugin lo riscrive in plugins/MagixLanguage/ ad ogni avvio. -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>README.md</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
