<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.teolo</groupId>
    <artifactId>MagixScoreboard</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>MagixScoreboard</name>
    <description>Scoreboard laterale con placeholder Magix/PAPI, condizioni (permesso, mondo, regione WorldGuard) e priorita' per peso</description>

    <properties>
        <!-- paper-api 26.1.2 e' compilata per Java 25 (class file 69.0): serve JDK 25 per buildare.
             Sul PC di sviluppo sta in C:\Users\teolo\.jdks\jdk-25.0.3+9 (vedi README). -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <!-- WorldGuard/WorldEdit: solo per compilare contro l'API delle regioni (softdepend, mai
             imbustati nel jar). Se WorldGuard non e' installato sul server le scoreboard con
             condizioni "regions" semplicemente non corrispondono mai (vedi hook/WorldGuardHook). -->
        <repository>
            <id>enginehub-repo</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <!-- Stesso build del server (log: "Paper version 26.1.2-72-ver/26.1.2"). -->
            <version>26.1.2.build.72-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- Opzionale a runtime (softdepend): fornito dal plugin se presente. Copre sia i
             placeholder standard sia quelli registrati dagli altri plugin Magix (ognuno si
             espone come propria expansion PAPI, es. %magixfactions_...%, %magixtime_...%). -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- Opzionali a runtime (softdepend): solo per l'API delle regioni (hook/WorldGuardHook). -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>7.0.19</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
            <version>7.4.5</version>
            <scope>provided</scope>
        </dependency>
        <!-- Solo per compilare contro MagixLanguageAPI (softdepend, mai imbustato nel jar): il
             workflow di deploy installa MagixLanguage nel repo Maven locale prima di questo
             plugin (vedi .github/workflows/deploy-plugin.yml). A runtime, se MagixLanguage non
             e' installato sul server, il codice non tocca mai questa classe (vedi lang/Messages). -->
        <dependency>
            <groupId>com.teolo</groupId>
            <artifactId>MagixLanguage</artifactId>
            <version>0.4.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Include il README dalla root del progetto: non e' piu' riscritto a runtime (lo fa
                 StaffGuide nella cartella dati, vedi MagixScoreboard.writeStaffGuide), ma resta nel
                 jar come sorgente leggibile insieme al codice. -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>README.md</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
